{
  "name": "tradedesk-mobile",
  "version": "1.0.0",
  "main": "src/App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:prod": "eas build --profile production --platform all",
    "eas:submit:ios": "eas submit --platform ios --profile production",
    "eas:submit:android": "eas submit --platform android --profile production",
    "eas:update": "eas update --branch production --message 'auto update'"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~53.0.0",
    "expo-asset": "^57.0.9",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.2.0",
    "expo-device": "~7.1.0",
    "expo-image-picker": "~16.1.0",
    "expo-linear-gradient": "~14.1.0",
    "expo-notifications": "~0.31.0",
    "expo-secure-store": "~14.2.0",
    "expo-status-bar": "~2.2.0",
    "react": "18.3.1",
    "react-native": "0.77.1",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "eas-cli": "^12.0.0",
    "typescript": "~5.8.0"
  },
  "private": true
}
