#!/usr/bin/env python3
"""orch - Zero-bias research protocol orchestrator CLI.

Usage:
    orch --runs 30                # Run all 30 bias-free research runs
    orch --runs 5                 # Run first 5 runs only
    orch --dry-run                # Preview without executing sandboxes
    orch --list-prompts           # List the 30 research prompts
    orch --list-prompts --prompt BLANK.json  # List prompts from a specific preset

Each run is isolated in its own E2B sandbox with a research prompt as the
only directional input. Sandboxes are destroyed after each run, guaranteeing
zero domain bias carryover. A single harness is used for all runs — isolation
comes from sandbox destruction, not from swapping cosmetic configurations.
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Optional

REPO_ROOT = Path.cwd()
ORCHESTRATOR = REPO_ROOT / ".agent" / "internal" / "orchestrate-30-runs.py"


def load_json(path: Path) -> dict:
    with open(path) as f:
        return json.load(f)


def list_prompts(prompt_file_path: Optional[str] = None) -> None:
    if prompt_file_path:
        candidate1 = Path(prompt_file_path).resolve()
        candidate2 = (REPO_ROOT / ".agent" / "internal" / prompt_file_path).resolve()
        prompt_path = candidate1 if candidate1.exists() else candidate2
        if not prompt_path.exists():
            print(f"Prompt file not found: {candidate1} or {candidate2}", file=sys.stderr)
            return
    else:
        prompt_path = REPO_ROOT / ".agent" / "internal" / "research-prompts.json"
    rp = load_json(prompt_path)
    for i, entry in enumerate(rp["prompts"], start=1):
        ptext = entry.get("prompt", "")[:80].replace("\n", " ")
        print(f"Run {i}: {ptext}...")


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="orch",
        description="Zero-bias research protocol orchestrator. Runs N isolated "
                    "E2B-sandboxed research runs with neutral prompts. Each run "
                    "is isolated in its own sandbox; sandboxes are destroyed "
                    "after each run. A single harness is used for all runs.",
    )
    parser.add_argument("--runs", type=int, default=30,
                        help="Number of research runs (default: 30, max: 30)")
    parser.add_argument("--dry-run", action="store_true", default=False,
                        help="Preview without provisioning sandboxes")
    parser.add_argument("--list-prompts", action="store_true", default=False,
                        help="List research prompts and exit")
    parser.add_argument("--prompt", type=str, default=None,
                        help="Custom prompt JSON file (e.g., business.json, BLANK.json)")

    args = parser.parse_args()

    if args.list_prompts:
        list_prompts(args.prompt)
        return

    runs = min(max(args.runs, 1), 30)
    print(f"orch: zero-bias research protocol")
    print(f"  {runs} isolated E2B sandbox runs (single harness, sandboxes destroyed after each)")
    print()

    cmd = [sys.executable, str(ORCHESTRATOR)]
    if args.dry_run:
        cmd.append("--dry-run")
    if args.prompt:
        cmd.extend(["--prompt", args.prompt])
    cmd.extend(["--max-runs", str(runs)])

    result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
    if result.stdout:
        print(result.stdout)
    if result.stderr:
        print(result.stderr, file=sys.stderr)
    if result.returncode != 0:
        print(f"\norchestrator exited with code {result.returncode}", file=sys.stderr)
        sys.exit(result.returncode)


if __name__ == "__main__":
    main()
